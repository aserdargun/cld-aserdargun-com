{
  "name": "cloud-comparison-app",
  "description": "A source-backed cloud cost comparison app for Turkey-accessible services.",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:codex": "npm run stop:codex && vite --host 127.0.0.1 --port 4173 --strictPort",
    "stop:codex": "node scripts/stop-dev.mjs",
    "validate:codex": "npm run stop:codex && npm run check && npm run e2e && git diff --check",
    "build": "tsc -b && vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "lint": "eslint .",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-catalog.ts",
    "e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run validate:data && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
